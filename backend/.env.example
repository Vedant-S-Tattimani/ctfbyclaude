# Copy to .env and adjust. MONGODB_URI is required; everything else is optional.
# With Docker (docker compose up), MONGODB_URI is ignored: the app uses the MongoDB container instead.
MONGODB_URI=mongodb+srv://<db_username>:<db_password>@<cluster-host>/?retryWrites=true&w=majority
MONGODB_DB=cipherarena
# Set if mongodb+srv:// lookups fail with "querySrv ECONNREFUSED" (Node can't use the system resolver for SRV records)
# DNS_SERVERS=1.1.1.1,8.8.8.8
# First platform admin, created on start when the database has no admin yet
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.org
# At least 10 characters. Use a long passphrase and keep it out of git.
ADMIN_PASSWORD=
PORT=3000
HOST=0.0.0.0
# Public URL, used in emailed links (printed to the log until you add a mailer)
BASE_URL=http://localhost:3000
NODE_ENV=development
# Local folder for challenge attachments (kept out of the database)
DATA_DIR=data
# Secret for per-team dynamic flags. Generated and stored in the database if unset.
# Changing it changes every dynamic flag.
# APP_SECRET=
SESSION_DAYS=14
MAX_UPLOAD_MB=100
SUBMIT_PER_MINUTE=5
LOGIN_LIMIT_PER_IP=60
LOGIN_LIMIT_PER_ACCOUNT=10
# Set to 1 when running behind a reverse proxy (nginx, Caddy) so client IPs are correct
TRUST_PROXY=0
# Secure (HTTPS-only) session cookie. Defaults to on when NODE_ENV=production.
# COOKIE_SECURE=1
# Return verification/reset links in API responses (defaults to on outside production)
# EXPOSE_DEV_LINKS=1
# Challenge instances: none | docker  (docker needs the docker CLI and daemon on this host)
INSTANCE_PROVIDER=none
INSTANCE_HOST=localhost
INSTANCE_MAX_PER_TEAM=3
# Frontend directory (defaults to ../frontend, the sibling folder)
# FRONTEND_DIR=../frontend
# CORS origin for frontend dev server (leave empty when backend serves frontend)
# CORS_ORIGIN=http://localhost:5500
# Sign-in is handled by Firebase Authentication (backend/serviceAccountKey.json is required for it).
# Web app settings from Firebase console > Project settings > Your apps > Web app. They are public by design.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
# Sign-in buttons besides email/password: google, github (enable the same ones in Authentication > Sign-in method)
FIREBASE_SIGNIN_PROVIDERS=google
# Cloudflare Turnstile captcha on sign-in/sign-up (dash.cloudflare.com > Turnstile). Leave empty to turn it off.
# Local testing keys that always pass: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Email through Nodemailer (verification + password reset). Gmail: turn on 2-Step Verification, then create an
# App Password at https://myaccount.google.com/apppasswords. Leave empty to let Firebase send these emails.
# Note: Render's free plan blocks outgoing SMTP, so this works locally and on paid plans only.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# MAIL_FROM=fs0cie1y <you@gmail.com>
# Firebase service account (sign-in, 2FA secrets, and the admin/organizer directory in the Realtime Database)
# Place serviceAccountKey.json in backend/ or specify path:
# FIREBASE_SERVICE_ACCOUNT_PATH=serviceAccountKey.json
# Custom Firebase Realtime Database URL (defaults to https://<project_id>-default-rtdb.asia-southeast1.firebasedatabase.app):
# FIREBASE_DATABASE_URL=https://<project-id>-default-rtdb.firebaseio.com
