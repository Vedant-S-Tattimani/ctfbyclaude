{
  "name": "cipherarena-backend",
  "version": "1.0.0",
  "description": "CipherArena — CTF hosting, management and competition platform (backend API)",
  "private": true,
  "type": "module",
  "main": "server/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch-path=server server/index.js",
    "bootstrap": "node scripts/bootstrap.js",
    "verify": "node scripts/verify-setup.js",
    "test": "node --test --test-concurrency=1 test/*.test.js",
    "seed:practice": "node scripts/seed-practice.js",
    "migrate:auth": "node scripts/migrate-auth-to-firebase.js"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5.3.0",
    "firebase-admin": "^14.5.1",
    "mongodb": "^6.22.0",
    "multer": "^2.5.0"
  }
}
